30bb\u30b9\u6599\u91d1(1\u4eba1\u65e5 \u20ac5\u301c10\u3001\u7279\u5b9a\u65e5\u306e\u307f):\u5bbf\u6cca\u8005\u306f\u514d\u9664\u3060\u304c\u3001\u4e8b\u524d\u306b\u514d\u9664\u30af\u30fc\u30dd\u30f3\u3092 cda.ve.it/en/ \u3067\u7533\u8acb\u3057\u3001\u5230\u7740\u6642\u306b\u8eab\u5206\u8a3c\u3068\u63d0\u793a\u3059\u308b\u5fc5\u8981\u3042\u308a\u3002\u5bfe\u8c61\u65e5\u304b\u3069\u3046\u304b\u3082\u540c\u30b5\u30a4\u30c8\u3067\u78ba\u8a8d</li> </ul>"},{"location":"%E6%97%85%E8%A1%8C/2026-%E3%83%A8%E3%83%BC%E3%83%AD%E3%83%83%E3%83%91%E6%97%85%E8%A1%8C%E8%A8%88%E7%94%BB-%E6%A6%82%E8%A6%81/#_7","title":"\u8cbb\u7528(\u30a8\u30af\u30b9\u30da\u30c7\u30a3\u30a2\u652f\u6255\u3044\u5206)","text":"\u5185\u5bb9 \u5408\u8a08 \u3046\u3061\u73fe\u5730\u6255\u3044 \u884c\u304d\u822a\u7a7a\u5238 + \u30a6\u30a3\u30fc\u30f3\u306e\u30db\u30c6\u30eb \u00a5421,613 \u00a52,771 \u30a6\u30a3\u30fc\u30f3\u2192\u30d9\u30cd\u30c1\u30a2\u822a\u7a7a\u5238 + \u30d9\u30cd\u30c1\u30a2\u306e\u30db\u30c6\u30eb \u00a559,756 \u00a52,486 \u5e30\u308a\u822a\u7a7a\u5238(\u5ea7\u5e2d\u6307\u5b9a\u6599\u8fbc\u307f) \u00a5290,315 \u2014 \u8a08 \u00a5771,684 \u00a55,257 <p>\u203b \u30ed\u30fc\u30de\u306e\u30db\u30c6\u30eb\u3001\u5217\u8eca\u3001\u5404\u7a2e\u5165\u5834\u6599\u3001LOT\u306e\u9810\u3051\u5165\u308c\u624b\u8377\u7269\u306f\u5225\u9014</p>"},{"location":"%E6%97%85%E8%A1%8C/2026-%E3%83%A8%E3%83%BC%E3%83%AD%E3%83%83%E3%83%91%E6%97%85%E8%A1%8C%E8%A8%88%E7%94%BB-%E6%A6%82%E8%A6%81/#_8","title":"\u65e5\u7a0b","text":"\u65e5\u4ed8 \u90fd\u5e02 \u5348\u524d \u5348\u5f8c \u591c \u5bbf\u6cca 12/19(\u571f) \u79fb\u52d5 \u6210\u753010:10\u767a \u30a4\u30b9\u30bf\u30f3\u30d6\u30fc\u30eb\u4e57\u7d99 \u30a6\u30a3\u30fc\u30f321:55\u7740\u3001\u7a7a\u6e2f\u6a2a\u30db\u30c6\u30eb\u3078 \u30a6\u30a3\u30fc\u30f3\u7a7a\u6e2f 12/20(\u65e5) \u30a6\u30a3\u30fc\u30f3 \u30b7\u30a7\u30fc\u30f3\u30d6\u30eb\u30f3\u5bae\u6bbf(\u5ead\u5712\u542b\u3080) \u5e02\u5e81\u820e\u524d\u30af\u30ea\u30b9\u30de\u30b9\u30de\u30fc\u30b1\u30c3\u30c8\u3001\u65e7\u5e02\u8857\u6563\u7b56\u3001\u30b7\u30e5\u30c6\u30d5\u30a1\u30f3\u5927\u8056\u5802 \u30ab\u30d5\u30a7\u30fb\u5915\u98df \u30a6\u30a3\u30fc\u30f3\u7a7a\u6e2f 12/21(\u6708) \u30a6\u30a3\u30fc\u30f3 \u30d9\u30eb\u30f4\u30a7\u30c7\u30fc\u30ec\u5bae\u6bbf(\u30af\u30ea\u30e0\u30c8\u300a\u63a5\u543b\u300b) \u56fd\u7acb\u6b4c\u5287\u5834\u898b\u5b66\u3001\u4ed6\u306e\u30af\u30ea\u30b9\u30de\u30b9\u30de\u30fc\u30b1\u30c3\u30c8\u5de1\u308a \u30aa\u30da\u30e9\u307e\u305f\u306f\u30de\u30fc\u30b1\u30c3\u30c8 \u30a6\u30a3\u30fc\u30f3\u7a7a\u6e2f 12/22(\u706b) \u30a6\u30a3\u30fc\u30f3\u2192\u30d9\u30cd\u30c1\u30a2 \u30c1\u30a7\u30c3\u30af\u30a2\u30a6\u30c8\u3001\u7a7a\u6e2fT3\u3078(12:50\u767a) 13:55\u7740\u3001\u5e02\u5185\u3078\u79fb\u52d5\u3001\u30db\u30c6\u30eb\u3001\u30b5\u30f3\u30fb\u30de\u30eb\u30b3\u5e83\u5834\u5468\u8fba \u5915\u66ae\u308c\u306e\u6563\u7b56\u30fb\u5915\u98df \u30d9\u30cd\u30c1\u30a2 12/23(\u6c34) \u30d9\u30cd\u30c1\u30a2 \u30b5\u30f3\u30fb\u30de\u30eb\u30b3\u5bfa\u9662\u3001\u30c9\u30a5\u30ab\u30fc\u30ec\u5bae\u6bbf \u30ea\u30a2\u30eb\u30c8\u6a4b\u30fb\u5e02\u5834\u3001\u8def\u5730\u6563\u7b56(\u30e0\u30e9\u30fc\u30ce\u5cf6\u30fb\u30d6\u30e9\u30fc\u30ce\u5cf6\u306f\u4efb\u610f) \u5915\u98df \u30d9\u30cd\u30c1\u30a2 12/24(\u6728) \u30d9\u30cd\u30c1\u30a2\u2192\u30ed\u30fc\u30de 10:30\u30c1\u30a7\u30c3\u30af\u30a2\u30a6\u30c8\u3001\u5217\u8eca\u3067\u30ed\u30fc\u30de\u3078(\u7d044\u6642\u9593) \u30db\u30c6\u30eb\u3001\u30c8\u30ec\u30f4\u30a3\u306e\u6cc9\u3001\u30b9\u30da\u30a4\u30f3\u5e83\u5834\u3001\u30d1\u30f3\u30c6\u30aa\u30f3\u3001\u30ca\u30f4\u30a9\u30fc\u30ca\u5e83\u5834 \u30af\u30ea\u30b9\u30de\u30b9\u30a4\u30d6\u306e\u5915\u98df \u30ed\u30fc\u30de 12/25(\u91d1) \u30ed\u30fc\u30de \u30b8\u30e3\u30cb\u30b3\u30ed\u306e\u4e18\u3001\u8056\u30da\u30c6\u30ed\u5e83\u5834(\u6b63\u5348\u306b\u6559\u7687\u306e\u30e1\u30c3\u30bb\u30fc\u30b8) \u30c8\u30e9\u30b9\u30c6\u30f4\u30a7\u30ec\u6563\u7b56\u3001\u30d1\u30f3\u30c6\u30aa\u30f3\u5468\u8fba(\u958b\u9928\u8981\u78ba\u8a8d) \u5915\u98df(\u55b6\u696d\u5e97\u8217\u8981\u78ba\u8a8d) \u30ed\u30fc\u30de 12/26(\u571f) \u30ed\u30fc\u30de \u30b3\u30ed\u30c3\u30bb\u30aa\u3001\u30d5\u30a9\u30ed\u30fb\u30ed\u30de\u30fc\u30ce\u3001\u30d1\u30e9\u30c6\u30a3\u30fc\u30ce\u306e\u4e18 \u30f4\u30a3\u30c3\u30c8\u30fc\u30ea\u30aa\u30fb\u30a8\u30de\u30cc\u30a8\u30fc\u30ec2\u4e16\u8a18\u5ff5\u5802\u3001\u30c1\u30eb\u30b3\u30fb\u30de\u30c3\u30b7\u30e2\u3001\u771f\u5b9f\u306e\u53e3 \u5915\u98df \u30ed\u30fc\u30de 12/27(\u65e5) \u30d5\u30a3\u30ec\u30f3\u30c4\u30a7\u65e5\u5e30\u308a \u65e9\u671d\u306e\u5217\u8eca\u3067\u30d5\u30a3\u30ec\u30f3\u30c4\u30a7\u3078(\u7d041.5\u6642\u9593)\u3001\u30c9\u30a5\u30aa\u30fc\u30e2(\u30af\u30fc\u30dd\u30e9) \u30a6\u30d5\u30a3\u30c4\u30a3\u7f8e\u8853\u9928(\u8981\u4e88\u7d04)\u3001\u30f4\u30a7\u30c3\u30ad\u30aa\u6a4b\u3001\u65e7\u5e02\u8857\u6563\u7b56 \u5915\u65b9\u306e\u5217\u8eca\u3067\u30ed\u30fc\u30de\u3078\u623b\u308b \u30ed\u30fc\u30de 12/28(\u6708) \u30ed\u30fc\u30de \u30d0\u30c1\u30ab\u30f3\u7f8e\u8853\u9928(\u30b7\u30b9\u30c6\u30a3\u30fc\u30ca\u793c\u62dd\u5802) \u30b5\u30f3\u30fb\u30d4\u30a8\u30c8\u30ed\u5927\u8056\u5802\u3001\u30dc\u30eb\u30b2\u30fc\u30bc\u7f8e\u8853\u9928(\u4e88\u7d04\u5236)\u307e\u305f\u306f\u7a4d\u307f\u6b8b\u3057 \u5915\u98df \u30ed\u30fc\u30de 12/29(\u706b) \u30ed\u30fc\u30de\u2192\u79fb\u52d5 \u671d\u30db\u30c6\u30eb\u51fa\u767a\u3001FCO 11:45\u767a \u30ef\u30eb\u30b7\u30e3\u30ef14:10\u7740\u3001\u4e57\u7d998\u6642\u959340\u5206(\u65e7\u5e02\u8857\u3078\u51fa\u308b\u6848\u3082) \u30ef\u30eb\u30b7\u30e3\u30ef22:50\u767a \u6a5f\u5185 12/30(\u6c34) \u79fb\u52d5 \u2014 \u2014 \u6210\u753019:40\u7740 \u2014 <p>\u203b \u4f11\u9928\u65e5\u30fb\u55b6\u696d\u6642\u9593\u30fb\u4e88\u7d04\u8981\u5426\u306f\u5909\u308f\u308b\u305f\u3081\u3001\u4e88\u7d04\u524d\u306b\u516c\u5f0f\u30b5\u30a4\u30c8\u3067\u8981\u78ba\u8a8d\u3002 \u203b 12/25(\u91d1)\u306f\u30b3\u30ed\u30c3\u30bb\u30aa\u30fb\u30d0\u30c1\u30ab\u30f3\u7f8e\u8853\u9928\u3068\u3082\u4f11\u9928\u306e\u53ef\u80fd\u6027\u304c\u9ad8\u3044\u305f\u3081\u5c4b\u5916\u4e2d\u5fc3\u300212/26(\u571f)\u306f\u30a4\u30bf\u30ea\u30a2\u306e\u795d\u65e5(\u8056\u30b9\u30c6\u30d5\u30a1\u30ce\u306e\u65e5)\u3002 \u203b \u30d5\u30a3\u30ec\u30f3\u30c4\u30a7\u65e5\u5e30\u308a\u306f\u3001\u30a6\u30d5\u30a3\u30c4\u30a3\u304c\u4f11\u9928\u306e\u6708\u66dc(12/28)\u3092\u907f\u3051\u306612/27(\u65e5)\u306b\u8a2d\u5b9a\u300212/27\u306f\u30d0\u30c1\u30ab\u30f3\u7f8e\u8853\u9928\u306e\u6708\u672b\u65e5\u66dc\u7121\u6599\u958b\u653e\u65e5\u3067\u5927\u6df7\u96d1\u306e\u53ef\u80fd\u6027\u304c\u3042\u308b\u305f\u3081\u3001\u30d0\u30c1\u30ab\u30f3\u306f12/28\u306b\u56de\u3059\u3002 \u203b 12/29\u306f\u5348\u524d\u4fbf\u306e\u305f\u3081\u89b3\u5149\u306f\u5165\u308c\u306a\u3044\u3002FCO\u3078\u306f\u30c6\u30eb\u30df\u30cb\u99c5\u304b\u3089\u30ec\u30aa\u30ca\u30eb\u30c9\u30fb\u30a8\u30af\u30b9\u30d7\u30ec\u30b9(\u7d0432\u5206)\u3002</p>"},{"location":"%E6%97%85%E8%A1%8C/2026-%E3%83%A8%E3%83%BC%E3%83%AD%E3%83%83%E3%83%91%E6%97%85%E8%A1%8C%E8%A8%88%E7%94%BB-%E6%A6%82%E8%A6%81/#_9","title":"\u6b8b\u30bf\u30b9\u30af","text":"<ul> <li>[ ] \u30ed\u30fc\u30de\u306e\u30db\u30c6\u30eb(12/24\u301c12/29\u30015\u6cca)\u3092\u4e88\u7d04</li> <li>[ ] \u30d9\u30cd\u30c1\u30a2\u2192\u30ed\u30fc\u30de\u306e\u5217\u8eca(12/24)\u3092\u4e88\u7d04</li> <li>[ ] \u30ed\u30fc\u30de\u21d4\u30d5\u30a3\u30ec\u30f3\u30c4\u30a7\u5f80\u5fa9\u306e\u5217\u8eca(12/27)\u3092\u4e88\u7d04</li> <li>[ ] \u30a6\u30d5\u30a3\u30c4\u30a3\u7f8e\u8853\u9928\u30fb\u30d0\u30c1\u30ab\u30f3\u7f8e\u8853\u9928\u30fb\u30b3\u30ed\u30c3\u30bb\u30aa\u30fb\u30dc\u30eb\u30b2\u30fc\u30bc\u7f8e\u8853\u9928\u3092\u4e88\u7d04</li> <li>[ ] LOT\u306e\u9810\u3051\u5165\u308c\u624b\u8377\u7269\u3092\u8ffd\u52a0(\u5fc5\u8981\u306a\u500b\u6570)</li> <li>[ ] \u30db\u30c6\u30eb \u30ec\u30aa\u30fc\u30cd\u3078\u30c1\u30a7\u30c3\u30af\u30a4\u30f3\u624b\u914d\u306e\u9023\u7d61(12/19\u307e\u3067\u306b=72\u6642\u9593\u524d)</li> <li>[ ] \u30d9\u30cd\u30c1\u30a2\u306e\u30a2\u30af\u30bb\u30b9\u6599\u91d1\u306e\u5bfe\u8c61\u65e5\u78ba\u8a8d\u3068\u514d\u9664\u30af\u30fc\u30dd\u30f3\u7533\u8acb</li> </ul>"},{"location":"%E6%97%85%E8%A1%8C/2026-%E3%83%A8%E3%83%BC%E3%83%AD%E3%83%83%E3%83%91%E6%97%85%E8%A1%8C%E8%A8%88%E7%94%BB-%E6%A6%82%E8%A6%81/#_10","title":"\u30ce\u30a6\u30cf\u30a6","text":"<ul> <li>\u4e57\u7d99\u306f3\u6642\u9593\u3042\u308b\u3068\u5b89\u5fc3\u30012\u6642\u9593\u306f\u3061\u3087\u3063\u3068\u5fc3\u8a31\u306a\u3044</li> <li>\u4e57\u7d99\u304c\u3042\u308b\u5834\u5408\u3001\u540c\u3058\u822a\u7a7a\u4f1a\u793e\u3067\u307e\u3068\u3081\u308b\u3068\u8377\u7269\u306e\u904b\u642c\u3084\u30c8\u30e9\u30d6\u30eb\u5bfe\u5fdc\u306a\u3069\u697d\u306b\u306a\u308b\u53ef\u80fd\u6027\u304c\u9ad8\u3044</li> <li>\u822a\u7a7a\u4f1a\u793e\u3054\u3068\u306b\u9810\u3051\u5165\u308c\u624b\u8377\u7269\u306e\u7121\u6599\u67a0\u304c\u9055\u3046(\u4eca\u56de\u306f\u30bf\u30fc\u30ad\u30c3\u30b7\u30e52\u500b\u7121\u6599\u3001\u30aa\u30fc\u30b9\u30c8\u30ea\u30a21\u500b\u7121\u6599\u3001LOT\u7121\u6599\u306a\u3057)\u3002\u4e88\u7d04\u6642\u306b\u8981\u78ba\u8a8d</li> </ul>"}]}